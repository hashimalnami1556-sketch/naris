+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FNarisNet001DownedReviver,
+    "NARIS.Coop.Character.ReviveRejectsDownedReviver",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+bool FNarisNet001DownedReviver::RunTest(const FString& Parameters)
+{
+    UWorld* W=Net001EditorTestWorld();
+    if (!W) { AddError(TEXT("No editor world")); return false; }
+    auto* A=W->SpawnActor<ANarisCoopCharacter>(FVector(0,0,200),FRotator::ZeroRotator);
+    auto* B=W->SpawnActor<ANarisCoopCharacter>(FVector(100,0,200),FRotator::ZeroRotator);
+    if (!A || !B) { if(A)A->Destroy();if(B)B->Destroy();return false; }
+    FDamageEvent D;
+    A->TakeDamage(10000.f,D,nullptr,B);
+    B->TakeDamage(10000.f,D,nullptr,A);
+    TestTrue(TEXT("Reviver downed"),A->IsDowned());
+    TestFalse(TEXT("Downed reviver rejected"),A->TryReviveTeammate());
+    TestTrue(TEXT("Teammate still downed"),B->IsDowned());
+    A->Destroy();B->Destroy();return true;
+}
