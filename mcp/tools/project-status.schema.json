{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "naris_project_status",
  "type": "object",
  "description": "Read-only project status contract for CALL OF NARIS.",
  "properties": {
    "repository": {"type":"string"},
    "branch": {"type":"string"},
    "version": {"type":"string"},
    "runtime": {"type":"string"},
    "milestone": {"type":"string"},
    "evidence": {"type":"array", "items":{"type":"string"}},
    "gates": {"type":"array", "items":{"type":"string"}}
  },
  "required": ["repository","branch","version","runtime","milestone","evidence","gates"]
}
