extends SceneTree
## Run only after Godot import: godot --headless --path . --script res://tests/test_fsm.gd
var checks: int = 0
func _check(condition: bool, label: String) -> void:
    checks += 1
    if not condition:
        push_error("FAILED check %d: %s" % [checks, label])
        quit(1)
        assert(condition, label)
func _initialize() -> void:
    var script: GDScript = load("res://scripts/combat_fsm.gd") as GDScript
    var fsm: NarisCombatFSM = script.new() as NarisCombatFSM
    root.add_child(fsm)
    _check(fsm.state == fsm.State.IDLE, "initial idle")
    _check(fsm.request_attack(), "attack accepted")
    _check(not fsm.request_attack(), "double attack denied")
    _check(not fsm.request_dodge(), "dodge during attack denied")
    _check(is_equal_approx(fsm.stamina, 80.0), "single stamina cost")
    fsm.tick(0.17)
    _check(fsm.damage_window, "attack window open")
    _check(fsm.register_attack_hit(100), "first target hit")
    _check(not fsm.register_attack_hit(100), "duplicate denied")
    _check(fsm.register_attack_hit(101), "second target permitted")
    fsm.tick(0.26)
    _check(not fsm.damage_window, "window closed")
    _check(not fsm.register_attack_hit(102), "no hit outside window")
    fsm.tick(0.3)
    _check(fsm.state == fsm.State.IDLE, "recovered")
    _check(fsm.request_dodge(), "dodge accepted")
    _check(is_equal_approx(fsm.stamina, 55.0), "dodge cost")
    fsm.tick(0.09)
    _check(fsm.invulnerable, "iframes active")
    _check(not fsm.receive_hit(20.0), "iframes block damage")
    _check(is_equal_approx(fsm.health, 100.0), "no damage")
    fsm.tick(0.3)
    _check(not fsm.invulnerable, "iframe timeout")
    fsm.tick(0.2)
    _check(fsm.state == fsm.State.IDLE, "dodge recovered")
    _check(fsm.set_block(true), "block active")
    _check(fsm.receive_hit(20.0), "block hit")
    _check(is_equal_approx(fsm.health, 95.0), "chip 25 percent")
    _check(fsm.state == fsm.State.BLOCK, "block maintained")
    _check(fsm.set_block(false), "block released")
    _check(not fsm.receive_hit(0.0), "zero ignored")
    _check(fsm.receive_hit(15.0), "damage accepted")
    _check(fsm.state == fsm.State.STUN, "hit stun")
    _check(not fsm.request_attack(), "stun denies attack")
    fsm.tick(0.4)
    _check(fsm.state == fsm.State.IDLE, "stun recovered")
    fsm.receive_hit(1000.0)
    _check(fsm.state == fsm.State.DEAD, "fatal blow")
    _check(not fsm.request_attack(), "dead cannot attack")
    _check(not fsm.request_dodge(), "dead cannot dodge")
    _check(not fsm.transition(fsm.State.IDLE), "dead lock")
    fsm.restore(75.0, 150.0)
    _check(fsm.state == fsm.State.IDLE, "restore revives")
    _check(is_equal_approx(fsm.stamina, 100.0), "restore max clamp")
    _check(is_equal_approx(fsm.health, 75.0), "restore health")
    fsm.restore(-4.0, -8.0)
    _check(fsm.state == fsm.State.DEAD, "restore dead")
    _check(is_equal_approx(fsm.stamina, 0.0), "restore min clamp")
    print("NARIS_P21_FSM_TESTS_PASS: %d checks" % checks)
    quit(0)
