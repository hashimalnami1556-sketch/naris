{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naris.local/schemas/naris-mcp-v1.tool-contract.json",
  "title": "NARIS MCP v1 Tool Contract",
  "type": "object",
  "required": ["name", "title", "description", "permission", "sideEffects"],
  "properties": {
    "name": {"type": "string", "pattern": "^naris\\.[a-z0-9_.-]{1,120}$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "permission": {"type": "string", "enum": ["project.read", "asset.read", "validation.run", "build.execute", "export.execute", "report.generate", "project.admin"]},
    "sideEffects": {"type": "string", "enum": ["none", "read", "write", "export"]},
    "audit": {"type": "boolean", "default": true}
  },
  "additionalProperties": false
}
